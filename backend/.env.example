# Copy to backend/.env and fill in from Supabase: Project Settings -> API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Server-only. Never put this in web/mobile code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key
# Google AI Studio key (needed later for recommendations)
GEMINI_API_KEY=
